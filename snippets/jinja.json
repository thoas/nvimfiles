{
  "if": {
    "prefix": "if",
    "body": ["{% if ${1:condition} %}", "\t$0", "{% endif %}"],
    "description": "if block"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": ["{% if ${1:condition} %}", "\t$2", "{% else %}", "\t$0", "{% endif %}"],
    "description": "if / else block"
  },
  "block": {
    "prefix": "block",
    "body": ["{% block ${1:name} %}", "\t$0", "{% endblock %}"],
    "description": "Template block"
  },
  "url": {
    "prefix": "url",
    "body": "{{ url('${1:app:route}') }}",
    "description": "Path of a named route"
  },
  "static": {
    "prefix": "static",
    "body": "{{ static('${1:path}') }}",
    "description": "URL of a static file"
  }
}
